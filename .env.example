APP_NAME=BoostLab
APP_VERSION=1.0

# Generate at OGAds dashboard — sent as Authorization: Bearer {key}
OFFERS_API_KEY=
# Current OGAds domain (older domains still work if you already use one)
OFFERS_ENDPOINT=https://appsave.online/api/v2
OFFERS_LIMIT=5
# Mobile/tablet only — bitwise: 1=CPI, 2=CPA, 4=PIN, 8=VID (e.g. 12=PIN+VID). Ignored on desktop.
OFFERS_CTYPE=1

SMM_GLOBE_API_KEY=
# MUST be verified on https://smmglobe.com/services before launch — IDs change over time
INSTAGRAM_FOLLOWERS_SERVICE_ID=4109
# MUST be verified on https://smmglobe.com/services before launch — IDs change over time
TIKTOK_FOLLOWERS_SERVICE_ID=4162

# Comma-separated OGAds postback source IPs (fail closed if empty)
POSTBACK_ALLOWED_IPS=50.18.215.132,50.18.215.133,50.18.215.134,50.18.215.135,107.21.28.235,107.21.36.214,107.23.2.46,107.23.2.50,54.64.15.176,54.64.21.195,54.94.179.76,54.207.34.180,54.207.36.218,54.246.166.8,54.246.166.9,54.246.166.12,54.246.166.17,209.170.120.242,209.170.120.243,209.170.120.244

// Set to true temporarily to surface SMMGlobe/postback errors in JSON responses
APP_DEBUG=false

# Database
DB_SERVER_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
