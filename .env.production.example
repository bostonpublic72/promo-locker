APP_NAME=BoostLab
APP_VERSION=1.0

# OGAds Offer API — generate key in OGAds dashboard (Bearer token)
OFFERS_API_KEY=
# VERIFY: current endpoint is https://appsave.online/api/v2 (legacy domains still work)
OFFERS_ENDPOINT=https://appsave.online/api/v2
OFFERS_LIMIT=5
# Mobile/tablet offer types — bitwise flag (1=CPI, 2=CPA, 4=PIN, 8=VID). No effect on desktop.
OFFERS_CTYPE=1

# SMMGlobe panel — from https://smmglobe.com/account
SMM_GLOBE_API_KEY=

# VERIFY BEFORE LAUNCH: open https://smmglobe.com/services and confirm these IDs match
#   [ ] Instagram followers service ID is correct for your target tier/region
#   [ ] TikTok followers service ID is correct for your target tier/region
INSTAGRAM_FOLLOWERS_SERVICE_ID=4109
TIKTOK_FOLLOWERS_SERVICE_ID=4162

# VERIFY BEFORE LAUNCH: confirm OGAds postback source IPs in their docs/dashboard
# Fail closed if this is empty — postbacks will be rejected
POSTBACK_ALLOWED_IPS=50.18.215.132,50.18.215.133,50.18.215.134,50.18.215.135,107.21.28.235,107.21.36.214,107.23.2.46,107.23.2.50,54.64.15.176,54.64.21.195,54.94.179.76,54.207.34.180,54.207.36.218,54.246.166.8,54.246.166.9,54.246.166.12,54.246.166.17,209.170.120.242,209.170.120.243,209.170.120.244

# Set to true temporarily to surface SMMGlobe/postback errors in JSON responses
APP_DEBUG=false

# cPanel MySQL — create database + user in cPanel first
DB_SERVER_NAME=localhost
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
